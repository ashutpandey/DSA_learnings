# ANALYSIS 6: Entropy
# ============================================================================

Write-Host "ANALYSIS 6: Entropy-Based Anomaly Detection" -ForegroundColor Green
Write-Host "═════════════════════════════════════════════" -ForegroundColor Green
Write-Host ""

$file6 = "$testDir\lnk_high_entropy_overlay.lnk"
if (Test-Path $file6) {
    $lnk6 = [System.IO.File]::ReadAllBytes($file6)

    Write-Host "File: $(Split-Path $file6 -Leaf)"
    Write-Host "Size: $($lnk6.Length) bytes"
    Write-Host ""

    # Calculate entropy of entire file
    $totalEntropy = Get-Entropy -Data $lnk6

    # Find terminator and calculate overlay entropy
    for ($i = 0; $i -lt $lnk6.Length - 3; $i++) {
        if ($lnk6[$i] -eq 0 -and $lnk6[$i+1] -eq 0 -and $lnk6[$i+2] -eq 0 -and $lnk6[$i+3] -eq 0) {
            $overlayStart = $i + 4
            $overlayData = $lnk6[$overlayStart..($lnk6.Length-1)]
            $overlayEntropy = Get-Entropy -Data $overlayData

            Write-Host "Entropy Analysis:" -ForegroundColor Yellow
            Write-Host "  Total file entropy: $totalEntropy bits/byte"
            Write-Host "  Overlay entropy: $overlayEntropy bits/byte"
            Write-Host ""
            Write-Host "  Normal LNK entropy: 3.0-5.5 bits/byte"
            Write-Host "  Compressed payload: 7.0-8.0 bits/byte"
            Write-Host ""

            if ($overlayEntropy -gt 6.5) {
                Write-Host "[!] DETECTION: High entropy overlay!" -ForegroundColor Red
                Write-Host "    Overlay entropy: $overlayEntropy (threshold: 6.5)"
                Write-Host "    Indicates: Compressed/encrypted payload"
                Write-Host "    Status: MALICIOUS" -ForegroundColor Red
            }

            break
        }
    }
}

