Write-Host "═════════════════════════════════════════" -ForegroundColor Green
Write-Host ""

$file5 = "$testDir\lnk_oversized_block.lnk"
if (Test-Path $file5) {
    $lnk5 = [System.IO.File]::ReadAllBytes($file5)

    Write-Host "File: $(Split-Path $file5 -Leaf)"
    Write-Host "Size: $($lnk5.Length) bytes"
    Write-Host ""

    # Find icon block (signature 0xA0000004)
    for ($i = 76; $i -lt $lnk5.Length - 8; $i++) {
        $sig = [BitConverter]::ToUInt32($lnk5[($i+4)..($i+7)], 0)
        if ($sig -eq 0xA0000004) {
            $blockSize = [BitConverter]::ToUInt32($lnk5[$i..($i+3)], 0)

            Write-Host "IconEnvironmentDataBlock found at offset 0x$($i.ToString('X4'))" -ForegroundColor Yellow
            Write-Host ""
            Write-Host "Block header:" -ForegroundColor Yellow
            Show-HexDump -Data $lnk5 -StartOffset $i -Length 8
            Write-Host ""

            Write-Host "Analysis:" -ForegroundColor Yellow
            Write-Host "  BlockSize field value: 0x$('{0:X4}' -f $blockSize) ($blockSize bytes)"
            Write-Host "  Actual content: ~50 bytes"
            Write-Host "  Unused space: ~$($blockSize - 50) bytes"
            Write-Host ""

            if ($blockSize -gt 256) {
                Write-Host "[!] DETECTION: Oversized block!" -ForegroundColor Red
                Write-Host "    Allocated: $blockSize bytes"
                Write-Host "    Used: ~50 bytes"
                Write-Host "    Unused: ~$($blockSize - 50) bytes (can hide payload)"
                Write-Host "    Status: SUSPICIOUS" -ForegroundColor Red
            }

            break
        }
    }
}

