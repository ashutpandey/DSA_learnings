# ============================================================================
# HELPER: Create basic valid LNK header
# ============================================================================

function Create-LNKHeader {
    $lnk = @()

    # Header (76 bytes)
    $lnk += 0x4C, 0x00, 0x00, 0x00  # Magic: 0x4C000000
    $lnk += @(0x01, 0x14, 0x02, 0x00)  # GUID part 1
    $lnk += @(0x00) * 12  # Rest of GUID

    # LinkFlags
    $lnk += 0x08, 0x00, 0x00, 0x00  # 0x00000008

    # File Attributes
    $lnk += 0x20, 0x00, 0x00, 0x00

    # Times (8 + 8 + 8 bytes)
    $lnk += @(0x00) * 24

    # FileSize, IconIndex, ShowCommand
    $lnk += @(0x00) * 4
    $lnk += @(0x00) * 4
    $lnk += 0x01, 0x00, 0x00, 0x00

    # HotKey, Reserved1, Reserved2, Reserved3
    $lnk += @(0x00) * 2
    $lnk += @(0x00) * 2
    $lnk += @(0x00) * 4
    $lnk += @(0x00) * 4

    # LinkInfo block
    $lnk += 0x1C, 0x00, 0x00, 0x00  # BlockSize
    $lnk += 0x1C, 0x00, 0x00, 0x00  # HeaderSize
    $lnk += @(0x00) * 16  # LinkInfoFlags, VolumeIDOffset, etc

    return [byte[]]$lnk
}

