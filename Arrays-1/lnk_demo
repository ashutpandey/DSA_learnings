# ============================================================================
# HELPER: Hex dump function
# ============================================================================

function Show-HexDump {
    param(
        [byte[]]$Data,
        [int]$StartOffset = 0,
        [int]$Length = 32
    )
    $endOffset = [Math]::Min($StartOffset + $Length, $Data.Length)
    for ($i = $StartOffset; $i -lt $endOffset; $i += 16) {
        $hex = ""
        $ascii = ""
        for ($j = 0; $j -lt 16 -and ($i + $j) -lt $endOffset; $j++) {
            $byte = $Data[$i + $j]
            $hex += "{0:X2} " -f $byte
            if ($byte -ge 32 -and $byte -le 126) {
                $ascii += [char]$byte
            } else {
                $ascii += "."
            }
        }
        Write-Host ("{0:X8}: {1,-48} {2}" -f ($i), $hex, $ascii) -ForegroundColor Gray
    }
}

# ============================================================================
# HELPER: Calculate entropy
# ============================================================================

function Get-Entropy {
    param([byte[]]$Data)

    $byteFreq = @{}
    foreach ($byte in $Data) {
        if ($byteFreq.ContainsKey($byte)) {
            $byteFreq[$byte]++
        } else {
            $byteFreq[$byte] = 1
        }
    }

    $entropy = 0
    foreach ($freq in $byteFreq.Values) {
        $prob = $freq / $Data.Length
        if ($prob -gt 0) {
            $entropy -= $prob * [Math]::Log2($prob)
        }
    }

    return [Math]::Round($entropy, 2)
}

