# ANALYSIS 1: Reserved Flags
# ============================================================================

Write-Host "ANALYSIS 1: Reserved Flags Detection" -ForegroundColor Green
Write-Host "════════════════════════════════════" -ForegroundColor Green
Write-Host ""

$file1 = "$testDir\lnk_reserved_flags.lnk"
if (Test-Path $file1) {
    $lnk1 = [System.IO.File]::ReadAllBytes($file1)

    Write-Host "File: $(Split-Path $file1 -Leaf)"
    Write-Host "Size: $($lnk1.Length) bytes"
    Write-Host ""

    Write-Host "LinkFlags at offset 0x14:" -ForegroundColor Yellow
    Show-HexDump -Data $lnk1 -StartOffset 0x14 -Length 4
    Write-Host ""

    $flagBytes = $lnk1[0x14..0x17]
    $flags = [BitConverter]::ToUInt32($flagBytes, 0)

    Write-Host "Analysis:" -ForegroundColor Yellow
    Write-Host "  Binary: $('{0:B32}' -f $flags)"
    Write-Host "  Hex: 0x$('{0:X8}' -f $flags)"
    Write-Host ""

    # Check reserved bits
    $reservedBits = ($flags -shr 11) -band 0xFFFFF
    if ($reservedBits -ne 0) {
        Write-Host "  [!] DETECTION: Reserved bits set to non-zero!" -ForegroundColor Red
        Write-Host "      Reserved bits (11-30): 0x$('{0:X5}' -f $reservedBits)"
        Write-Host "      Status: MALICIOUS" -ForegroundColor Red
    } else {
        Write-Host "  [✓] Reserved bits are 0 (normal)" -ForegroundColor Green
    }
}

Write-Host ""

# ============================================================================
# ANALYSIS 2: Overlay Data
# ============================================================================

Write-Host "ANALYSIS 2: Overlay Data Detection" -ForegroundColor Green
Write-Host "═══════════════════════════════════" -ForegroundColor Green
Write-Host ""

$file2 = "$testDir\lnk_overlay_data.lnk"
if (Test-Path $file2) {
    $lnk2 = [System.IO.File]::ReadAllBytes($file2)

    Write-Host "File: $(Split-Path $file2 -Leaf)"
    Write-Host "Size: $($lnk2.Length) bytes"
    Write-Host ""

    # Find terminator (0x00000000)
    $terminatorOffset = -1
    for ($i = 0; $i -lt $lnk2.Length - 3; $i++) {
        if ($lnk2[$i] -eq 0 -and $lnk2[$i+1] -eq 0 -and $lnk2[$i+2] -eq 0 -and $lnk2[$i+3] -eq 0) {
            $terminatorOffset = $i
            break
        }
    }

    if ($terminatorOffset -ge 0) {
        $expectedEnd = $terminatorOffset + 4

        Write-Host "DataBlockTerminator found at offset: 0x$($terminatorOffset.ToString('X4'))" -ForegroundColor Yellow
        Write-Host "Expected LNK end: $expectedEnd bytes"
        Write-Host "Actual file size: $($lnk2.Length) bytes"
        Write-Host ""

        if ($lnk2.Length -gt $expectedEnd + 10) {
            $overlaySize = $lnk2.Length - $expectedEnd
            Write-Host "[!] DETECTION: Overlay data found!" -ForegroundColor Red
            Write-Host "    Overlay size: $overlaySize bytes"
            Write-Host "    Overlay starts at: 0x$($expectedEnd.ToString('X4'))"
            Write-Host ""

            Write-Host "Overlay content (first 32 bytes):" -ForegroundColor Yellow
            Show-HexDump -Data $lnk2 -StartOffset $expectedEnd -Length 32
            Write-Host ""

            # Check for known markers
            $overlayData = $lnk2[$expectedEnd..($lnk2.Length-1)]
            if ($overlayData -contains 0x1F -and $overlayData.Length -gt 2 -and $overlayData[1] -eq 0x8B) {
                Write-Host "    [!] gzip compression detected (1F 8B header)" -ForegroundColor Red
            }

            Write-Host "    Status: MALICIOUS" -ForegroundColor Red
        }
    }
}

Write-Host ""

# ============================================================================
# ANALYSIS 3: Null Byte Truncation
# ============================================================================

Write-Host "ANALYSIS 3: Null-Byte String Truncation Detection" -ForegroundColor Green
Write-Host "═══════════════════════════════════════════════════" -ForegroundColor Green
Write-Host ""

$file3 = "$testDir\lnk_null_byte_truncation.lnk"
if (Test-Path $file3) {
    $lnk3 = [System.IO.File]::ReadAllBytes($file3)

    Write-Host "File: $(Split-Path $file3 -Leaf)"
    Write-Host "Size: $($lnk3.Length) bytes"
    Write-Host ""

    # Find string data with null bytes
    Write-Host "Scanning for null-byte patterns in string data:" -ForegroundColor Yellow

    $foundNullBytes = $false
    for ($i = 76; $i -lt $lnk3.Length - 3; $i++) {
        # Look for non-null, null, null, non-null pattern (typical in UTF-16)
        if ($lnk3[$i] -ne 0 -and $lnk3[$i+1] -eq 0 -and $lnk3[$i+2] -eq 0 -and $lnk3[$i+3] -ne 0) {
            $foundNullBytes = $true

            Write-Host ""
            Write-Host "[!] DETECTION: Null-byte pattern found at offset 0x$($i.ToString('X4'))" -ForegroundColor Red
            Show-HexDump -Data $lnk3 -StartOffset ($i - 8) -Length 32
            Write-Host ""
            Write-Host "    Interpretation:"
            Write-Host "      Before null: Valid string (truncated here by parser)"
            Write-Host "      After null: Hidden command (executed by Windows)"
            Write-Host "    Status: MALICIOUS" -ForegroundColor Red
            break
        }
    }

    if (-not $foundNullBytes) {
        Write-Host "[✓] No obvious null-byte truncation patterns detected"
    }
}

